# Copie para .env e ajuste. O .env não é versionado.

# --- Desenvolvimento -------------------------------------------------------

# Porta do host em que o docker compose expõe a aplicação.
# Dentro do contêiner a aplicação escuta sempre na 8000.
PORTA=8000

# --- Produção (VPS com Traefik) --------------------------------------------
# Descomente na VPS. O COMPOSE_FILE faz o "docker compose" ler os dois
# arquivos sem precisar de -f; em produção o PORTA não é usado, porque o
# docker-compose.prod.yml tira a porta publicada.

# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# DOMINIO=transcrito.brunobrito.tech

# Nomes da configuração do Traefik. Os padrões são os do template Docker +
# Traefik da Hostinger; confira com: docker inspect <traefik> | grep -i entrypoint
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
